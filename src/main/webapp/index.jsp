<html>
<title>BroadCastly</title>
<body>
<h2>Welcome to BroadCastly</h2>
<h3>Upload Your contact list</h3>
<form action="uploadContacts" method="post" enctype="multipart/form-data">
    <label for="file">Upload Contacts : </label>
    <input type="file" name="file" accept=".csv" required>
    <button type="submit">Upload</button>
</form>


</body>
</html>